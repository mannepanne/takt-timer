{
  "name": "takt-timer",
  "version": "0.1.0",
  "private": true,
  "description": "Takt — a voice-driven, mobile-first interval timer on Cloudflare.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n spa,worker -c cyan,magenta \"pnpm dev\" \"pnpm worker:dev\"",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "fonts:copy": "node scripts/copy-fonts.mjs",
    "cap:sync": "pnpm build:native && cap sync android",
    "android:check": "node scripts/check-android-manifest.mjs",
    "build:aab": "pnpm cap:sync && ./android/gradlew -p android bundleRelease",
    "store:assets": "node store-assets/generate.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "worker:dev": "wrangler dev",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "capacitor-native-settings": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.2.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "workbox-build": "7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^3.96.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
