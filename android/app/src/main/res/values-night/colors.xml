<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night override for the splash background: the dark "paper" token from src/styles.css. The
         launcher-icon background (ic_launcher_background, declared in values/) is deliberately NOT
         overridden: icons do not change with theme. drawable-night/splash_logo.png carries the
         matching paper-ink wordmark. -->
    <color name="splash_background">#101214</color>
    <!-- Dark paper: the WebView's pre-paint background when the OS is in night mode, so there is
         no white frame between the splash and the page's first paint. -->
    <color name="window_background">#101214</color>
</resources>
