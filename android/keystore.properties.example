# Template for android/keystore.properties — copy to `keystore.properties` (gitignored) and fill in.
# This file configures RELEASE signing for the signed AAB uploaded to Google Play.
# NEVER commit the real keystore.properties or the .jks it points at — see REFERENCE/android-app.md.
#
# storeFile is resolved relative to the android/ directory (rootProject).
storeFile=takt-release.jks
storePassword=CHANGE_ME
keyAlias=takt
keyPassword=CHANGE_ME
